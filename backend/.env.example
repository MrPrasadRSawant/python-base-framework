# App
APP_NAME=Base API
ENVIRONMENT=development
# true -> 500 responses include the exception type/message (never use in production)
DEBUG=true
API_V1_PREFIX=/api/v1

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:9000

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app_db

# Logging
LOG_LEVEL=INFO
# Console format: text | json   (log files are always JSON)
LOG_FORMAT=text
LOG_TO_FILE=true
# Relative paths resolve from backend/
LOG_DIR=logs
LOG_FILE_MAX_BYTES=10485760
LOG_FILE_BACKUP_COUNT=5
# Log SQL statements (bound parameters may contain personal data)
LOG_SQL=false
# Attach the (redacted) request body to error logs
LOG_REQUEST_BODY_ON_ERROR=true
LOG_MAX_BODY_BYTES=4096

# Log tables (stored in addition to the log files)
EXCEPTION_LOG_DB_ENABLED=true
# Lowest HTTP status stored: 400 = all API errors, 500 = server errors only
EXCEPTION_LOG_DB_MIN_STATUS=400
# One row per request (method, route, status, duration); comma-separated paths to skip
REQUEST_LOG_DB_ENABLED=true
REQUEST_LOG_EXCLUDE_PATHS=/api/v1/health
# One row per @track_service call (all BaseService methods are tracked)
SERVICE_CALL_LOG_DB_ENABLED=true
# Background writer shared by all log tables
DB_LOG_QUEUE_SIZE=10000
DB_LOG_BATCH_SIZE=50
DB_LOG_FLUSH_INTERVAL=1.0

# Read-only /api/v1/exception-logs, /request-logs and /service-call-logs endpoints
# (add auth before enabling in production)
EXCEPTION_LOG_API_ENABLED=true
REQUEST_LOG_API_ENABLED=true
SERVICE_CALL_LOG_API_ENABLED=true

# Pagination / search
PAGINATION_DEFAULT_LIMIT=20
PAGINATION_MAX_LIMIT=100
SEARCH_MAX_FILTERS=20
SEARCH_MAX_IN_VALUES=100

# Request tracing
REQUEST_ID_HEADER=X-Request-ID

# Redaction: extra comma-separated keys to mask, on top of the built-in list
REDACT_EXTRA_KEYS=
# Mask emails in log text (j***@example.com)
REDACT_EMAILS=true

# Authentication
# Required, >= 32 chars: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ISSUER=base-api
ACCESS_TOKEN_TTL_MINUTES=15
# Failed logins in a row before the account is locked, and for how long
LOGIN_MAX_FAILED=5
LOGIN_LOCK_MINUTES=15
# Allow anyone to create an account with POST /auth/register
AUTH_SELF_REGISTRATION_ENABLED=false
# Local development only. Creates Admin and Developer demo users on startup.
DEV_SEED_ACCOUNTS=true
# Refresh token (HttpOnly cookie, rotated on every refresh)
REFRESH_TOKEN_TTL_DAYS=7
REFRESH_COOKIE_NAME=refresh_token
# true = cookie only over HTTPS (browsers still allow it on http://localhost)
REFRESH_COOKIE_SECURE=true
# lax | strict | none (none requires REFRESH_COOKIE_SECURE=true)
REFRESH_COOKIE_SAMESITE=lax
# Access token lifetime for API clients (client credentials grant)
SERVICE_TOKEN_TTL_MINUTES=15

# Rate limiting per client IP (in memory, per worker): "<count>/<second|minute|hour>"
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_REGISTER=5/minute
RATE_LIMIT_REFRESH=30/minute
RATE_LIMIT_TOKEN=60/minute
RATE_LIMIT_TOKEN_PER_CLIENT=30/minute
