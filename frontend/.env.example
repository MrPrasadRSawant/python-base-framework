# Quasar only exposes variables prefixed with QCLI_ to client code
# (read them via import.meta.env.QCLI_*)
QCLI_APP_NAME=Baseframe
# Same-origin path: the dev server proxies /api to the backend (quasar.config.js).
# In production, serve the app and the API behind the same domain.
QCLI_API_BASE_URL=/api/v1
# Dev proxy target (the FastAPI server)
QCLI_API_PROXY_TARGET=http://localhost:8000
